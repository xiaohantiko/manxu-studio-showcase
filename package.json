{
  "name": "manxu-studio-showcase",
  "version": "0.3.1",
  "private": true,
  "description": "漫序 Studio · AI 漫剧创作工作台",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "pack:mac": "npm run build && electron-builder --mac dir --arm64 --publish never",
    "check": "node --test tests/*.test.mjs services/*.test.cjs cloud/test/*.test.mjs"
  },
  "build": {
    "appId": "studio.manxu.showcase",
    "productName": "漫序 Studio 公开版",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "src/portable.js",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/admin.cjs",
      "electron/vault.cjs",
      "electron/workspace.cjs",
      "services/api.cjs",
      "services/cloud-client.cjs",
      "services/connection.cjs",
      "services/backup-config.cjs"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": "dir",
      "icon": "build/icon.icns"
    }
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5"
  },
  "type": "module",
  "author": "Manxu Studio"
}
